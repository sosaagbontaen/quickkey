#!/bin/bash
# package -- build a shareable QuickKey installer for macOS.
set -e
cd "$(dirname "$0")"
EXT=extension
QK_VER=$(sed -n 's/^var QK_VERSION = "\(.*\)";/\1/p' extension/js/commands.js)
OUT=dist/QuickKey
rm -rf dist && mkdir -p "$OUT"

# 1. the panel (pure HTML/JS -- identical on Mac and Windows)
cp -R "$EXT" "$OUT/com.quickkey.dev"
rm -f "$OUT/com.quickkey.dev/.debug"        # remote debugging is a dev-only door

# 2. the daemon, built for both Apple Silicon and Intel
APP="$OUT/QuickKeyDaemon.app"
mkdir -p "$APP/Contents/MacOS"
cp daemon/QuickKeyDaemon.app/Contents/Info.plist "$APP/Contents/Info.plist"
mkdir -p "$APP/Contents/Resources"
cp assets/build/QuickKey.icns "$APP/Contents/Resources/QuickKey.icns"
swiftc -O -target arm64-apple-macos12  -o /tmp/qkd-arm64 daemon/main.swift
swiftc -O -target x86_64-apple-macos12 -o /tmp/qkd-x86   daemon/main.swift
lipo -create /tmp/qkd-arm64 /tmp/qkd-x86 -output "$APP/Contents/MacOS/QuickKeyDaemon"
rm -f /tmp/qkd-arm64 /tmp/qkd-x86
codesign --force --sign - "$APP"

# 3. installer -- a real .app so a non-technical user never sees a terminal.
#    Payload lives inside the bundle, so the whole thing is one file to send.
INST="$OUT/Install QuickKey.app"
mkdir -p "$INST/Contents/MacOS" "$INST/Contents/Resources"
cp assets/build/QuickKey.icns "$INST/Contents/Resources/QuickKey.icns"
mv "$OUT/com.quickkey.dev" "$INST/Contents/Resources/"
cp -R "$OUT/QuickKeyDaemon.app" "$INST/Contents/Resources/"
rm -rf "$OUT/QuickKeyDaemon.app"

cat > "$INST/Contents/Info.plist" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Install QuickKey</string>
  <key>CFBundleDisplayName</key><string>Install QuickKey</string>
  <key>CFBundleIdentifier</key><string>com.quickkey.installer</string>
  <key>CFBundleExecutable</key><string>installer</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>VERSION_PLACEHOLDER</string>
  <key>CFBundleIconFile</key><string>QuickKey</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
</dict>
</plist>
PLIST
sed -i "" "s/VERSION_PLACEHOLDER/$QK_VER/" "$INST/Contents/Info.plist"

cat > "$INST/Contents/MacOS/installer" << 'INNER'
#!/bin/bash
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
say() { osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with title \"QuickKey\"" >/dev/null 2>&1; }

xattr -dr com.apple.quarantine "$RES" 2>/dev/null

EXTDIR="$HOME/Library/Application Support/Adobe/CEP/extensions"
mkdir -p "$EXTDIR" || { say "Could not create the Premiere extensions folder."; exit 1; }
rm -rf "$EXTDIR/com.quickkey.dev"
cp -R "$RES/com.quickkey.dev" "$EXTDIR/" || { say "Could not install the panel."; exit 1; }

# Premiere refuses unsigned extensions unless this is on. Local and reversible.
for v in 10 11 12 13; do defaults write "com.adobe.CSXS.$v" PlayerDebugMode 1 2>/dev/null; done

mkdir -p "$HOME/Applications"
rm -rf "$HOME/Applications/QuickKeyDaemon.app"
cp -R "$RES/QuickKeyDaemon.app" "$HOME/Applications/"
xattr -dr com.apple.quarantine "$HOME/Applications/QuickKeyDaemon.app" 2>/dev/null

# Start it now so there is one less step to explain.
open "$HOME/Applications/QuickKeyDaemon.app" 2>/dev/null

say "QuickKey installed.

Next:
1. Quit Premiere completely, then reopen it.
2. Window menu > Extensions > QuickKey
3. Click a clip, press Control-Option-B

The hotkey helper is already running in the background."
INNER
chmod +x "$INST/Contents/MacOS/installer"
codesign --force --deep --sign - "$INST" 2>/dev/null || true

# 4. README, written for someone who does not use a terminal
cat > "$OUT/READ ME FIRST.txt" << 'INNER'
QuickKey
========
Press one key, and the effect you chose lands on the clip you selected.


INSTALLING  (about a minute, and only once)

  1. Double-click "Install QuickKey".

  2. macOS will refuse and say it "could not verify" the app.
     Click Done.  Do NOT click "Move to Trash".

     This is expected. The app is not signed by Apple, because signing needs
     a paid developer account we do not have yet. Nothing is wrong.

  3. Open System Settings, then Privacy & Security.
     Scroll down to the Security section near the bottom.
     There is a line saying "Install QuickKey" was blocked,
     with an "Open Anyway" button. Click it, and confirm with your
     password or Touch ID.

  4. Double-click "Install QuickKey" again.
     This time it installs, and tells you when it is done.


THEN

  Quit Premiere completely and reopen it.
  Choose  Window > Extensions > QuickKey  to show the panel.

  Click a clip on the timeline and press  Control-Option-B.
  Click a different clip and press it again -- it follows your selection.
  That is the whole idea.


THE PANEL

  The key box     Click it, then press whatever key you want. Backspace clears.
  The effect name Click it to pick from every effect Premiere has.
  CAPTURE         Set an effect up on a clip exactly how you like it, keep that
                  clip selected, then press CAPTURE. Those settings become your
                  default. Open "N settings captured" to see or adjust them.
  x               Remove a default from this mode. Any of them.
  + add default   Make your own, e.g. a second grade.

  Cmd-Z undoes changes made in the panel.

  MODES are sets of defaults. The same key can be one blur in one mode and a
  different blur in another. Make as many as you like.


WHAT IS SET UP ALREADY

  Ctrl-Opt-B  blur           Ctrl-Opt-M  add marker
  Ctrl-Opt-G  grade          Ctrl-Opt-E  turn clip off/on
  Ctrl-Opt-T  transition     Ctrl-Opt-F  scale to frame
  Ctrl-Opt-A  audio effect   Ctrl-Opt-D  ripple delete
  Ctrl-Opt-S  sharpen        Ctrl-Opt-X  remove all effects
  Ctrl-Opt-1  switch mode

  Drop Shadow, Transform, Crop and Lens Distortion are ready but have no key
  yet -- click their key box to give them one.


THINGS WE ALREADY KNOW ARE WRONG  (please tell us what else you find)

  - Every shortcut needs Ctrl and Option held down. Plain single keys get
    swallowed by macOS everywhere, with no way to give them back. Whether it
    is worth a scary permission prompt to get real single keys is one of the
    main things we want your opinion on.
  - CAPTURE remembers numbers and switches, but not colours. So it works well
    for blurs, and it does NOT properly remember a Lumetri grade yet.
  - Some dropdown settings show as "Option 0 / 1 / 2" instead of real names.
  - Transitions land at the start of the selected clip.
  - If something fails, the Activity box at the bottom of the panel shows a red
    line. Please copy it and send it over -- that is genuinely useful to us.


TURNING IT OFF

  The hotkeys come from a small background app called QuickKeyDaemon,
  in your Applications folder. Quit it and every key goes back to normal.
  It does not start by itself when you reboot -- open it again when you want it.
INNER

cd dist && zip -qr "QuickKey-mac-v$QK_VER.zip" QuickKey && cd ..
echo
echo "built: dist/QuickKey-mac-v$QK_VER.zip  ($(du -h "dist/QuickKey-mac-v$QK_VER.zip" | cut -f1))"
lipo -archs "$INST/Contents/Resources/QuickKeyDaemon.app/Contents/MacOS/QuickKeyDaemon" | sed 's/^/  daemon architectures: /'
